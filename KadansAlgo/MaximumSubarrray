class Solution {
    public int maxSubArray(int[] nums) {
        int be= nums[0];
        int ans=nums[0];
        for(int i=1;i<nums.length;i++){
            int v  =be+nums[i];
            int n=nums[i];
            be=Math.max(v,n);
            ans=Math.max(be,ans);
        }
        return ans;
    }
}