class Solution {
    static int smallestSumSubarray(int a[], int size) {
        // your code here
        int be=a[0];
        int ans=a[0];
        for(int i=1;i<size;i++){
            int p=be+a[i];
            int o=a[i];
            be=Math.min(p,o);
            ans=Math.min(ans,be);
        }
        return ans;
    }
}