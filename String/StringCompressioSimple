import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.next();
        
        String ans="";
        int count=1;
        for(int i=0;i<s.length();i++){
            Character ch=s.charAt(i);
            if(i+1<s.length() && ch==s.charAt(i+1)){
                count++;
            }else{
                ans+=ch+""+count;
                count=1;
            }
        }
        System.out.println(ans);
        

    }
}