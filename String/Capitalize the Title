class Solution {
    public String capitalizeTitle(String title) {
        String[] words=title.split(" ");
        String ans="";
        for(int i=0;i<words.length;i++){
            String s=words[i];
            if(s.length() <= 2) {
                s = s.toLowerCase();
            }else{
            s=s.substring(0,1).toUpperCase()+s.substring(1).toLowerCase();}
            ans+=s+" ";
        }
        return ans.trim();
    }
}