import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.next();
        String sub=sc.next();
        int count=0;
        for(int i=0;i<=s.length()-sub.length();i++){
            if(s.substring(i,i+sub.length()).equals(sub)){
                count++;
            }

        }
        System.out.println(count);
    }
}